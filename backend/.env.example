# Para usar seu PostgreSQL instalado (o modo local automático dispensa estas variáveis).
# Copie os valores para as variáveis da configuração de execução ou do terminal.
# Spring Boot não carrega este arquivo automaticamente.
DB_URL=jdbc:postgresql://localhost:5432/barberflow_dev
DB_USERNAME=postgres
DB_PASSWORD=preencha_localmente
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
